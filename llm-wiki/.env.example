# LLM-Anbindung ueber einen OpenAI-kompatiblen Endpoint. LLM_BASE_URL zeigt auf
# den /v1-Pfad des Anbieters; leer lassen heisst OpenAI direkt. Fehlt der Key,
# laeuft die App ohne Modell weiter (Rohbelege statt Antwort, Fallback-Header).
LLM_BASE_URL=https://hybridai.one/v1
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# Nur fuer Anbieter, die eine Chatbot-ID verlangen (z.B. hybridai.one).
# Leer lassen, wenn der Endpoint reines OpenAI-Protokoll spricht.
LLM_CHATBOT_ID=

# Secret fuer die Signatur des Identitaets-Cookies (mpb_user). Fehlt es, wird beim
# Start ein zufaelliges Secret erzeugt und alle Sessions verfallen beim Neustart.
# Erzeugen z.B. mit: python -c "import secrets; print(secrets.token_hex(32))"
MPB_SECRET=

# Passwortschutz vor der gesamten App (app/basic_auth.py), noetig sobald die
# App nicht nur auf 127.0.0.1 lauscht - der Rollen-Login /login hat bewusst
# kein Passwort. Beide Werte leer/ungesetzt = kein Schutz.
MPB_BASIC_AUTH_USER=
MPB_BASIC_AUTH_PASS=
